  {
    "id": "feishu",
    "name": "飞书文档",
    "description": "搜索、读取、创建和更新飞书云文档。",
    "category": "文档与网盘",
    "source": "https://open.feishu.cn/document/mcp_open_tools/supported-tools",
    "setup": {
      "url": "https://mcp.feishu.cn/mcp",
      "oauth": true,
      "registration": "FEISHU",
      "secretHeader": "X-Lark-MCP-UAT",
      "headers": {
        "X-Lark-MCP-Allowed-Tools": "search-doc,fetch-doc,create-doc,update-doc"
      },
      "guide": "使用飞书中国版账号授权。Fox 只能操作该账号有权访问的云文档。"
    }
  },
