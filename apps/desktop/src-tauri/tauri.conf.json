{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fox",
  "version": "0.1.0",
  "identifier": "com.fox.agent",
  "build": {
    "beforeDevCommand": "node ../../scripts/prepare-officecli.mjs && node ../../scripts/start-desktop-dev.mjs",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "node ../../scripts/prepare-officecli.mjs && node ../../scripts/prepare-windows-runtime.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fox",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=msEdgeFluentOverlayScrollbar"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://models.dev; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ejiidnob33g9ap1r.public.blob.vercel-storage.com; worker-src 'self' blob:; frame-src 'self' fox-preview: http: https:; media-src 'self' blob: data: asset: http://asset.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://models.dev; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* https://ejiidnob33g9ap1r.public.blob.vercel-storage.com; worker-src 'self' blob:; frame-src 'self' fox-preview: http: https:; media-src 'self' blob: data: asset: http://asset.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/officecli/*": "officecli/",
      "resources/pdf-renderer/*": "pdf-renderer/",
      "../../../services/agent-runtime/src/fake-runtime.mjs": "agent-runtime/fake-runtime.mjs",
      "../../../services/agent-runtime/src/pi-runtime.mjs": "agent-runtime/pi-runtime.mjs",
      "../../../services/agent-runtime/src/offline-evaluator.mjs": "agent-runtime/offline-evaluator.mjs",
      "../../../services/agent-runtime/evals/fixtures/*": "evals/fixtures/",
      "../../../services/agent-runtime/src/pi-event-mapper.mjs": "agent-runtime/pi-event-mapper.mjs",
      "../../../services/agent-runtime/src/read-only-tool-executors.mjs": "agent-runtime/read-only-tool-executors.mjs",
      "../../../services/agent-runtime/src/read-only-tools.mjs": "agent-runtime/read-only-tools.mjs",
      "../../../services/agent-runtime/src/runtime-session.mjs": "agent-runtime/runtime-session.mjs",
      "../../../services/agent-runtime/src/protocol.mjs": "agent-runtime/protocol.mjs",
      "../../../services/agent-runtime/dist/*": "agent-runtime/",
      "resources/models/trusted-release-keys/fox-release-2026.json": "models/trusted-release-keys/fox-release-2026.json",
      "target/*/build/zvec-rust-sys-*/out/zvec-prebuilt/zvec_c_api.dll": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
