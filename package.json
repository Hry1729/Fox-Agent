{
  "name": "fox-workspace",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "protocol:generate": "node scripts/generate-engine-protocol.mjs",
    "protocol:check": "node scripts/generate-engine-protocol.mjs --check",
    "protocol:test": "node --test packages/fox-engine-protocol/test/*.test.mjs",
    "kernel:test": "cargo test -p fox-agent-kernel",
    "prepare:office": "node scripts/prepare-officecli.mjs",
    "experts:build": "node scripts/build-expert-library.mjs",
    "dev": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "check:bundle": "pnpm --dir apps/desktop check:bundle",
    "desktop:test": "bun test ./apps/desktop/tests",
    "runtime:test": "pnpm --dir services/agent-runtime test",
    "runtime:eval": "pnpm --dir services/agent-runtime eval:offline",
    "runtime:build": "pnpm --dir services/agent-runtime build:sidecar",
    "runtime:smoke": "pnpm --dir services/agent-runtime smoke:sidecar",
    "contract-fixtures:verify": "node scripts/validate-contract-fixtures.mjs",
    "contract-fixtures:test": "node --test scripts/validate-contract-fixtures.test.mjs",
    "knowledge:verify-preview": "node scripts/verify-knowledge-preview-contract.mjs",
    "knowledge:verify-preview:test": "node --test scripts/verify-knowledge-preview-contract.test.mjs",
    "tauri": "pnpm --dir apps/desktop tauri",
    "tauri:build": "pnpm prepare:office && pnpm runtime:build && pnpm --dir apps/desktop tauri build",
    "tauri:build:windows": "pnpm prepare:office && pnpm runtime:build && pnpm --dir apps/desktop tauri build --bundles nsis --config src-tauri/tauri.installer.conf.json",
    "tauri:build:kernel-preview": "pnpm prepare:office && pnpm runtime:build && pnpm --dir apps/desktop tauri build --bundles nsis --features kernel-default --config src-tauri/tauri.kernel-preview.conf.json"
  },
  "dependencies": {
    "border-beam": "^1.3.0"
  }
}
