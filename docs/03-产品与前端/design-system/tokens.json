  "typography": {
    "fontFamily": "\"HarmonyOS Sans SC\", \"Segoe UI Variable\", \"Segoe UI\", \"Microsoft YaHei\", system-ui, sans-serif",
    "fontFamilyMono": "\"Cascadia Code\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
    "scaleVariable": "--fox-text-scale",
    "scaleRange": [70, 140],
    "scaleDefault": 100,
    "weights": { "regular": 400, "medium": 500, "semibold": 600 },
    "sizes": [
      { "token": "--fox-type-micro", "px": 11, "usage": "最小字号：元数据、角标" },
      { "token": "--fox-type-caption", "px": 12, "usage": "辅助说明、时间、快捷键、徽标" },
      { "token": "--fox-type-chrome", "px": 13, "usage": "侧栏、菜单、控件、页面说明" },
      { "token": "--fox-type-body", "px": 14, "usage": "正文、卡片内容、表单值" },
      { "token": "--fox-type-workbench", "px": 15, "usage": "对话正文" },
      { "token": "--fox-type-title", "px": 16, "usage": "对话框标题、区块标题" },
      { "token": "--fox-type-page", "px": 24, "usage": "页面标题" },
      { "token": "--fox-type-display", "px": 32, "usage": "首页式大标题" }
    ],
    "lineHeight": { "body": "1.6–1.75", "control": "1.4", "heading": "1.2–1.3" },
    "lineLength": { "desktop": "65–75ch", "mobile": "35–60ch" }
  },
  "spacing": {
    "grid": "4px",
    "tokens": [
      { "token": "--fox-space-micro", "px": 2 },
      { "token": "--fox-space-xs", "px": 4 },
      { "token": "--fox-space-s", "px": 6 },
      { "token": "--fox-space-m", "px": 8 },
      { "token": "--fox-space-l", "px": 12 },
      { "token": "--fox-space-xl", "px": 16 },
      { "token": "--fox-space-2xl", "px": 20 },
      { "token": "--fox-space-3xl", "px": 24 },
      { "token": "--fox-space-4xl", "px": 32 },
      { "token": "--fox-space-5xl", "px": 40 },
      { "token": "--fox-space-6xl", "px": 48 },
      { "token": "--fox-space-8xl", "px": 64 }
    ]
  },
  "layout": {
    "contentMax": "1120px",
    "pagePadding": { "top": "32px", "inline": "24px", "bottom": "48px" },
    "sectionGap": "24px",
    "cardPadding": "16px",
    "titlebarHeight": "30px",
    "sidebarWidth": "264px",
    "sidebarRowHeight": "32px"
  },
  "controls": {
    "heights": { "xs": "24px", "sm": "28px", "md": "32px", "lg": "36px" },
    "actionHeight": "32px",
    "inlineActionHeight": "28px",
    "badgeHeight": "20px",
    "iconSizes": { "compact": "12px", "small": "14px", "default": "16px", "large": "20px", "xl": "24px" },
    "focus": { "width": "2px", "offset": "2px", "halo": "3px" }
  },
  "elevation": {
    "sm": "0 1px 2px color-mix(in oklch, var(--fox-shadow-color) 6%, transparent)",
    "md": "0 4px 16px color-mix(in oklch, var(--fox-shadow-color) 9%, transparent)",
    "lg": "0 16px 45px color-mix(in oklch, var(--fox-shadow-color) 12%, transparent)",
    "rule": "普通卡片无阴影；sm 凸起控件，md 菜单与浮层，lg 对话框"
  },
  "zIndex": { "sheet": 50, "alertDialog": 50, "dialog": 100, "select": 110 },
  "motion": {
    "durations": { "fast": "120ms", "base": "160ms", "slow": "240ms" },
    "easings": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "rules": [
      "动效只表达状态变化、层级或因果",
      "进入用 ease-out，离开更快",
      "列表项错开 30–50ms",
      "尊重 prefers-reduced-motion"
    ]
  },
  "icons": {
    "family": "Lucide",
    "grid": 24,
    "strokeWidth": 2,
    "sizes": [12, 14, 16, 20, 24],
    "rule": "不混用实心与描边，不用 emoji 代替功能图标"
  },
  "notes": [
    "颜色唯一来源是 themes.css；组件不得直接写十六进制或 Tailwind 调色板类。",
    "圆角随主题变化，嵌套圆角按“外层 − 内距”计算。",
    "正文 14px、对话 15px 是桌面密度取舍；网页通用下限 16px 不直接套用。",
    "Tailwind 的 rem 单位与 14px 根字号冲突，修复前不要用 rem 间距作为规范基准。"
  ]
}
